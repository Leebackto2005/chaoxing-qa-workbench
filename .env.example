# Local is the default. Official mode requires an explicit opt-in below.
CHAOXUN_USERNAME=test_user
CHAOXUN_PASSWORD=test_password
CHAOXUN_URL=http://127.0.0.1:8765
TEST_TARGET=local
ALLOW_OFFICIAL_TEST=false
OFFICIAL_URL=https://v8.chaoxing.com
MOCK_SERVER=true
BROWSER=chrome
HEADLESS=false
BROWSER_TIMEOUT=30
LESSON_SECONDS=1.0
PLAYBACK_SECONDS=10.0
OFFICIAL_PLAYBACK_SCOPE=latest_unfinished
OFFICIAL_MAX_LESSONS=1
OFFICIAL_TASK_POINTS=2
OFFICIAL_PLAYER_WAIT_SECONDS=5
OFFICIAL_PLAYBACK_RATE=2
LOG_LEVEL=INFO
LOG_FILE=logs/chaoxun.log
SCREENSHOT_DIR=screenshots
PROGRESS_FILE=progress.json
REPORT_FILE=playback_report.json
# Optional CSS selectors for an authorized official test adapter. Leave blank
# to use semantic input/link/media discovery.
OFFICIAL_USERNAME_SELECTOR=
OFFICIAL_PASSWORD_SELECTOR=
OFFICIAL_LOGGED_IN_SELECTOR=
OFFICIAL_COURSE_SELECTOR=
OFFICIAL_LESSON_SELECTOR=
OFFICIAL_PLAY_SELECTOR=
MOCK_HOST=127.0.0.1
MOCK_PORT=8765
