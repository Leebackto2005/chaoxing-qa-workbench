# Docker 默认运行本地模拟回归，不访问外部平台。
CHAOXUN_USERNAME=test_user
CHAOXUN_PASSWORD=test_password
CHAOXUN_URL=http://127.0.0.1:8765
TEST_TARGET=local
ALLOW_OFFICIAL_TEST=false
OFFICIAL_URL=https://v8.chaoxing.com
MOCK_SERVER=true
# Docker Compose 固定使用镜像内置 Chromium 和无头模式。
BROWSER_TIMEOUT=30
LESSON_SECONDS=1.0
PLAYBACK_MINUTES=10.0
PROTECTION_NAVIGATION_INTERVAL_SECONDS=3.0
PROTECTION_POLL_INTERVAL_SECONDS=1.0
PROTECTION_FAILURE_COOLDOWN_SECONDS=300
OFFICIAL_PLAYBACK_SCOPE=latest_unfinished
OFFICIAL_MAX_LESSONS=1
OFFICIAL_TASK_POINTS=2
OFFICIAL_PLAYER_WAIT_SECONDS=5
OFFICIAL_PLAYBACK_RATE=2
COURSE_IDS=
LOG_LEVEL=INFO
UI_PORT=8787

# 官方授权测试时，使用专用测试账号，并在授权窗口内人工完成验证码。
# ALLOW_OFFICIAL_TEST=true
# TEST_TARGET=official
# HEADLESS=false
